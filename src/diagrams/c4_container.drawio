<?xml version="1.0" encoding="UTF-8"?>
<!--
  C4 Level 2 – Container Diagram
  PySpark Declarative Pipelines Demo

  Shows the internal containers (modules) of the system and their
  relationships.  Each container maps to a Python module in src/python/.
-->
<mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1"
              tooltips="1" connect="1" arrows="1" fold="1" page="1"
              pageScale="1" pageWidth="1169" pageHeight="827"
              math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <!-- Title -->
    <mxCell id="title" value="C4 Level 2 – Container Diagram: PySpark Declarative Pipelines Demo"
            style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1"
            vertex="1" parent="1">
      <mxGeometry x="150" y="20" width="869" height="40" as="geometry" />
    </mxCell>

    <!-- System boundary -->
    <mxCell id="boundary" value="PySpark Declarative Pipelines Demo [Software System]"
            style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];shape=mxgraph.lean_mapping.electronic_info_store_2;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#444444;strokeWidth=2;dashed=1;fontSize=13;fontStyle=1;verticalAlign=top;"
            vertex="1" parent="1">
      <mxGeometry x="220" y="80" width="729" height="630" as="geometry" />
    </mxCell>

    <!-- ===== Container: pipelines.py ===== -->
    <mxCell id="pipelines" value="&lt;b&gt;pipelines.py&lt;/b&gt;&lt;br/&gt;[Python Module]&lt;br/&gt;&lt;br/&gt;Declares all Bronze, Silver, Gold, and&lt;br/&gt;Dimension pipeline datasets using&lt;br/&gt;@table / @materialized_view decorators.&lt;br/&gt;Entry points: register_user_pipeline(),&lt;br/&gt;register_customer_pipeline()."
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168bd;fontColor=#ffffff;strokeColor=#0b4884;fontSize=11;arcSize=5;"
            vertex="1" parent="1">
      <mxGeometry x="390" y="140" width="250" height="160" as="geometry" />
    </mxCell>

    <!-- ===== Container: io.py ===== -->
    <mxCell id="io" value="&lt;b&gt;io.py&lt;/b&gt;&lt;br/&gt;[Python Module]&lt;br/&gt;&lt;br/&gt;Reads raw data from external&lt;br/&gt;sources.&lt;br/&gt;read_users_csv()&lt;br/&gt;read_customers_parquet()"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168bd;fontColor=#ffffff;strokeColor=#0b4884;fontSize=11;arcSize=5;"
            vertex="1" parent="1">
      <mxGeometry x="250" y="390" width="200" height="150" as="geometry" />
    </mxCell>

    <!-- ===== Container: transformations.py ===== -->
    <mxCell id="transformations" value="&lt;b&gt;transformations.py&lt;/b&gt;&lt;br/&gt;[Python Module]&lt;br/&gt;&lt;br/&gt;All pure DataFrame transformations:&lt;br/&gt;filtering, enrichment, aggregation,&lt;br/&gt;SCD Type 1 &amp; Type 2 merge logic."
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168bd;fontColor=#ffffff;strokeColor=#0b4884;fontSize=11;arcSize=5;"
            vertex="1" parent="1">
      <mxGeometry x="500" y="390" width="220" height="150" as="geometry" />
    </mxCell>

    <!-- ===== Container: utils.py ===== -->
    <mxCell id="utils" value="&lt;b&gt;utils.py&lt;/b&gt;&lt;br/&gt;[Python Module]&lt;br/&gt;&lt;br/&gt;Shared helpers:&lt;br/&gt;deduplicate_by_latest(),&lt;br/&gt;SCD2 building-block functions,&lt;br/&gt;SCD2_TRACKED_COLUMNS constant."
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168bd;fontColor=#ffffff;strokeColor=#0b4884;fontSize=11;arcSize=5;"
