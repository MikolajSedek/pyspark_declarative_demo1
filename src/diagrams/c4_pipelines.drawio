      <mxGeometry x="80" y="370" width="180" height="110" as="geometry" />
    </mxCell>

    <!-- Gold: gold_user_count_by_country -->
    <mxCell id="gold_user"
            value="&lt;b&gt;gold_user_count_by_country&lt;/b&gt;&lt;br/&gt;[@materialized_view]&lt;br/&gt;&lt;br/&gt;aggregate_user_count_by_country()"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4a017;fontColor=#333333;strokeColor=#9a7100;fontSize=11;arcSize=5;"
            vertex="1" parent="1">
      <mxGeometry x="80" y="520" width="220" height="100" as="geometry" />
    </mxCell>

    <!-- P1 arrows -->
    <mxCell id="r_p1_src_bronze" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" source="p1_src" target="bronze_users" parent="1">
