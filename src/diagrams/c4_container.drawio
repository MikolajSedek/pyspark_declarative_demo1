    <!-- ===== External: CSV files ===== -->
    <mxCell id="csv_ext" value="&lt;b&gt;CSV Files&lt;/b&gt;&lt;br/&gt;[External: data/users.csv]&lt;br/&gt;&lt;br/&gt;Raw user records."
