      <mxGeometry x="80" y="230" width="180" height="100" as="geometry" />
    </mxCell>

    <!-- Silver: silver_active_users -->
    <mxCell id="silver_active"
            value="&lt;b&gt;silver_active_users&lt;/b&gt;&lt;br/&gt;[@materialized_view]&lt;br/&gt;&lt;br/&gt;filter_active_users()&lt;br/&gt;enrich_with_full_name()"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c0c0c0;fontColor=#333333;strokeColor=#888888;fontSize=11;arcSize=5;"
